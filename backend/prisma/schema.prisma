datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum CategoryType {
  TOPS
  BOTTOMS
  OUTERWEAR
  DRESSES
}

enum SizeEnum {
  S
  M
  L
  XL
}

enum ColorEnum {
  BLACK
  WHITE
  GRAY
  BEIGE
  BROWN
  NAVY
  GREEN
  RED
  BLUE
  YELLOW
  PURPLE
  PINK
  ORANGE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  DELIVERED
  RETURNED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  COD
  STRIPE
  VNPAY
}

// ==========================================
// MODELS
// ==========================================

model User {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  fullName    String
  email       String   @unique
  password    String
  avatar      String?
  phoneNumber String?
  gender      Gender   @default(OTHER)
  role            UserRole   @default(USER)
  emailVerifiedAt DateTime?
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  cart      Cart?
  orders    Order[]
  reviews   Review[]
  wishlist  Wishlist?
  addresses Address[]
  notifications Notification[]

  @@map("users")
}

model Category {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String       @unique
  type        CategoryType
  description String?
  image       String?
  createdAt   DateTime     @default(now())

  products Product[]

  @@map("categories")
}

model Product {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  slug          String        @unique
  description   String
  categoryId    String        @db.ObjectId
  category      Category      @relation(fields: [categoryId], references: [id])
  thumbnail     String
  images        String[]
  price         Float
  discountPrice Float?
  material      String?
  fit           String?
  style         String?
  tags          String[]
  sold          Int           @default(0)
  views         Int           @default(0)
  ratingAverage Float         @default(0.0)
  totalReviews  Int           @default(0)
  status        ProductStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  variants ProductVariant[]
  reviews  Review[]

  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  productId String    @db.ObjectId
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      SizeEnum
  color     ColorEnum
  stock     Int
  sku       String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("product_variants")
}

model Cart {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  userId     String     @unique @db.ObjectId
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      CartItem[]
  totalPrice Float      @default(0.0)
  updatedAt  DateTime   @updatedAt

  @@map("carts")
}

model Order {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  userId          String        @db.ObjectId
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderCode       String        @unique
  items           OrderItem[]
  totalPrice      Float
  shippingFee     Float         @default(0.0)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(UNPAID)
  orderStatus     OrderStatus   @default(PENDING)
  shippingAddress String
  phoneNumber     String
  note            String?
  returnReason    String?
  returnStatus    String?       // PENDING, APPROVED, REJECTED
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@map("orders")
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

// OTP
model VerificationCode {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("verification_codes")
}

// ==========================================
// COMPOSITE TYPES (MongoDB Embedded Docs)
// ==========================================

type CartItem {
  productVariantId String @db.ObjectId
  quantity         Int
  price            Float
}

type OrderItem {
  productVariantId String    @db.ObjectId
  productId        String?   @db.ObjectId
  productName      String
  thumbnail        String
  quantity         Int
  size             SizeEnum
  color            ColorEnum
  price            Float
}

model Wishlist {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @unique @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productIds String[] @db.ObjectId
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("wishlists")
}

model Address {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  phoneNumber String
  province    String
  district    String
  ward        String
  detail      String
  latitude    Float?
  longitude   Float?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("addresses")
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}
